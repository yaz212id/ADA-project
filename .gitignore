# Spot prices are third-party data: downloaded by notebook 01, never committed
data/raw/prices/

# Original EIA .xls downloads (the CSV copies in data/raw/weekly/ are committed)
data/raw/xls/

# Processed files: derived from the third-party prices and regenerated by
# notebooks 01 and 02, so they are not committed (the folder itself is kept)
data/processed/*.csv
!data/processed/.gitkeep

# Unfinished downloads
*.part

# Testing area: every notebook change is tried here first, never submitted
drafts/

# Python caches and notebook checkpoints
__pycache__/
*.pyc
.ipynb_checkpoints/

# Virtual environments and secrets
.venv/
venv/
env/
.env

# Editor and system files
.vscode/
.idea/
.DS_Store
Thumbs.db
